{
  "description": "code-quality-plugin — Serena 우선 코드검색 경고 훅 · 시스템 python pytest 차단 훅 · pkill/pgrep -f 자기 매칭 차단 훅",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/serena_first.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/venv_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pkill_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
